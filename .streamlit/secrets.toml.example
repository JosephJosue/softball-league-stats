# =====================================================================
# Streamlit secrets template (for Streamlit Community Cloud / deployment)
#
# Local dev can use either this file or a ".env" file — settings.py reads
# st.secrets first, then falls back to environment variables.
#
# To use locally: copy to ".streamlit/secrets.toml" and fill in values.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# IMPORTANT: secrets.toml is git-ignored. NEVER commit real keys.
# =====================================================================

SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
