# =====================================================================
# Softball League Stats — environment variables (LOCAL DEV)
# Copy this file to ".env" and fill in your Supabase project values.
#   cp .env.example .env
#
# IMPORTANT: .env is git-ignored. NEVER commit real keys.
# =====================================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The PUBLIC "anon" key. Safe to ship to the client.
# Viewers use this for read-only access (enforced by Row Level Security).
SUPABASE_ANON_KEY=

# NOTE: The "service_role" key is intentionally NOT used by this app.
# It bypasses RLS and must never be exposed to the Streamlit client.
# Admins gain write access by logging in through the app (Supabase Auth),
# which runs queries as the "authenticated" role.
